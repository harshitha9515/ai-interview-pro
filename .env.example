# ==============================================================================
# AI Interview Pro — Server Environment Configuration
# ==============================================================================

# AI Provider Configuration ('gemini' | 'openai' | 'none')
# Set to 'none' or leave keys empty to use the intelligent built-in deterministic rubric engine.
AI_PROVIDER=gemini

# Google Gemini API Key (Never expose this key in client-side frontend code)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini Model identifier (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend API Server Port
PORT=3001
HOST=localhost
